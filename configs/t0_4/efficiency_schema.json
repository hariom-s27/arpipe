{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arpipe://t0.4/efficiency/1.0.0",
  "title": "Runtime telemetry separate from gold and model output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "engine_id",
    "document_id",
    "page_number",
    "cold_start_seconds",
    "model_load_seconds",
    "warm_runtime_seconds",
    "wall_seconds",
    "seconds_per_page",
    "pages_per_second",
    "cpu_seconds",
    "gpu_seconds",
    "peak_ram_bytes",
    "peak_vram_bytes",
    "failure",
    "timeout",
    "empty_output"
  ],
  "properties": {
    "engine_id": {"type": "string"},
    "document_id": {"type": "string"},
    "page_number": {"type": "integer", "minimum": 0},
    "cold_start_seconds": {"type": ["number", "string"], "minimum": 0},
    "model_load_seconds": {"type": ["number", "string"], "minimum": 0},
    "warm_runtime_seconds": {"type": ["number", "string"], "minimum": 0},
    "wall_seconds": {"type": ["number", "string"], "minimum": 0},
    "seconds_per_page": {"type": ["number", "string"], "minimum": 0},
    "pages_per_second": {"type": ["number", "string"], "minimum": 0},
    "cpu_seconds": {"type": ["number", "string"], "minimum": 0},
    "gpu_seconds": {"type": ["number", "string"], "minimum": 0},
    "peak_ram_bytes": {"type": ["integer", "string"], "minimum": 0},
    "peak_vram_bytes": {"type": ["integer", "string"], "minimum": 0},
    "failure": {"type": "boolean"},
    "timeout": {"type": "boolean"},
    "empty_output": {"type": "boolean"},
    "api_latency_seconds": {"type": ["number", "string"]},
    "request_count": {"type": ["integer", "string"]},
    "retry_count": {"type": ["integer", "string"]},
    "rate_limit_failures": {"type": ["integer", "string"]},
    "actual_cost": {"type": ["number", "string"]},
    "cost_currency": {"type": ["string", "null"]},
    "cost_per_page": {"type": ["number", "string"]},
    "cost_per_document": {"type": ["number", "string"]},
    "request_timestamp": {"type": ["string", "null"]}
  },
  "$comment": "Use NOT_AVAILABLE for unsupported telemetry. Cold start and steady state are separate. Runtime timestamps belong only here, never in deterministic artifacts."
}
