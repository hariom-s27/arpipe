{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arpipe://t0.4/benchmark-manifest/1.0.0",
  "title": "Deterministic dual-track benchmark manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "base_commit",
    "source_hashes",
    "track_a",
    "track_b",
    "derived_counts"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "base_commit": {"const": "ff030d97c13c8a2a977521bf91be2aca0cbf3034"},
    "source_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "track_a": {
      "type": "object",
      "required": ["unit_key", "units"],
      "properties": {
        "unit_key": {"const": ["document_id", "page_number"]},
        "units": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "document_id",
              "issuer_id",
              "fiscal_year",
              "page_number",
              "split",
              "sampling_stratum",
              "condition_labels",
              "condition_evidence",
              "representation_class",
              "era",
              "length_category",
              "benchmark_role",
              "source_pdf_sha256",
              "input_image_hash",
              "selection_rank"
            ],
            "properties": {
              "document_id": {"type": "string"},
              "issuer_id": {"type": "string"},
              "fiscal_year": {"type": "integer"},
              "page_number": {"type": "integer", "minimum": 0},
              "split": {"enum": ["FIT", "VALIDATION", "HOLDOUT"]},
              "sampling_stratum": {"type": "string"},
              "condition_labels": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
              "condition_evidence": {"type": "object", "additionalProperties": {"enum": ["VALIDATED_METADATA", "CANDIDATE_PROXY", "NOT_YET_ANNOTATED"]}},
              "representation_class": {"type": "string"},
              "era": {"enum": ["pre_2015", "post_2015"]},
              "length_category": {"enum": ["short", "medium", "long"]},
              "benchmark_role": {"enum": ["FIT_TUNING", "VALIDATION_PRE_FREEZE", "FINAL_HOLDOUT_LOCKED"]},
              "source_pdf_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "input_image_hash": {"const": "NOT_YET_RENDERED"},
              "selection_rank": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            }
          }
        }
      }
    },
    "track_b": {
      "type": "object",
      "required": ["unit_key", "units"],
      "properties": {
        "unit_key": {"const": ["document_id"]},
        "units": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["document_id", "issuer_id", "fiscal_year", "split", "benchmark_role", "document_conditions", "input_status", "source_pdf_sha256"],
            "properties": {
              "document_id": {"type": "string"},
              "issuer_id": {"type": "string"},
              "fiscal_year": {"type": "integer"},
              "split": {"enum": ["FIT", "VALIDATION", "HOLDOUT", "UNASSIGNED_HISTORICAL"]},
              "benchmark_role": {"enum": ["FIT_TUNING", "VALIDATION_PRE_FREEZE", "FINAL_HOLDOUT_LOCKED", "INPUT_UNAVAILABLE"]},
              "document_conditions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
              "input_status": {"enum": ["PROFILED_LOCAL_INPUT", "INPUT_UNAVAILABLE"]},
              "source_pdf_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            }
          }
        }
      }
    },
    "derived_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
  }
}
