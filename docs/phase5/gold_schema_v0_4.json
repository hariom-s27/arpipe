{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arpipe.local/schemas/gold_schema_v0_4.json",
  "title": "ARPipe DocumentGold raw and adjudicated record v0.4",
  "description": "DRAFT_PENDING_PILOT",
  "oneOf": [
    {"$ref": "#/$defs/rawRecord"},
    {"$ref": "#/$defs/adjudicatedRecord"}
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "page": {
      "type": "integer",
      "minimum": 0
    },
    "viewerPage": {
      "type": "integer",
      "minimum": 1
    },
    "span": {
      "type": "object",
      "required": ["start_page", "end_page"],
      "properties": {
        "start_page": {"$ref": "#/$defs/page"},
        "end_page": {"$ref": "#/$defs/page"}
      },
      "additionalProperties": false
    },
    "alternativeSpan": {
      "type": "object",
      "required": ["start_page", "end_page", "type"],
      "properties": {
        "start_page": {"$ref": "#/$defs/page"},
        "end_page": {"$ref": "#/$defs/page"},
        "type": {
          "enum": [
            "OTHER_ENGLISH_COPY",
            "HINDI_COPY",
            "OTHER_LANGUAGE_COPY",
            "OTHER_BODY_OCCURRENCE",
            "SUBSTANTIVE_START_ALTERNATIVE",
            "BOUNDARY_ALTERNATIVE"
          ]
        }
      },
      "additionalProperties": false
    },
    "commonRecord": {
      "type": "object",
      "required": [
        "schema_version",
        "record_type",
        "document_id",
        "source_pdf_sha256",
        "annotator_role",
        "presence_state",
        "presence_reason_code",
        "primary_span",
        "alternative_spans",
        "gap_pages",
        "flags",
        "ambiguity_code",
        "admissible_spans",
        "parent_section",
        "annexure_identity",
        "boundary_evidence",
        "timestamps",
        "aids_used",
        "structured_provenance",
        "protocol_version_hash"
      ],
      "properties": {
        "schema_version": {"const": "0.4"},
        "record_type": {"enum": ["RAW", "ADJUDICATED"]},
        "document_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "source_pdf_sha256": {"$ref": "#/$defs/sha256"},
        "annotator_role": {
          "enum": ["ANNOTATOR_A", "ANNOTATOR_B", "ADJUDICATED_RECORD"]
        },
        "presence_state": {"enum": ["PRESENT", "ABSENT", "AMBIGUOUS"]},
        "presence_reason_code": {
          "enum": [
            "BODY_QUALIFYING_TITLE",
            "CONDITIONAL_TITLE_CONTEXT_MET",
            "NO_QUALIFYING_BODY_SECTION",
            "TOC_ONLY",
            "POINTER_ONLY",
            "CONFUSABLE_SECTION_ONLY",
            "NOT_AN_ANNUAL_REPORT",
            "NO_ENGLISH_MDA",
            "EXTERNAL_REFERENCE_ONLY",
            "PRESENCE_UNRESOLVABLE",
            "START_UNRESOLVABLE",
            "END_UNRESOLVABLE",
            "SPAN_UNRESOLVABLE",
            "TITLE_CONTEXT_UNRESOLVABLE"
          ]
        },
        "primary_span": {
          "oneOf": [
            {"$ref": "#/$defs/span"},
            {"type": "null"}
          ]
        },
        "alternative_spans": {
          "type": "array",
          "items": {"$ref": "#/$defs/alternativeSpan"}
        },
        "gap_pages": {
          "type": "array",
          "items": {"$ref": "#/$defs/page"},
          "uniqueItems": true
        },
        "flags": {
          "type": "array",
          "items": {
            "enum": [
              "multiple_spans",
              "bilingual",
              "bilingual_interleaved",
              "noncontiguous_hull",
              "embedded_in_directors_report",
              "annexure",
              "unclear_start",
              "unclear_end",
              "mixed_start_page",
              "mixed_end_page",
              "conditional_title",
              "legacy_or_corrupted_boundary_heading",
              "stub",
              "contains_csr_esg"
            ]
          },
          "uniqueItems": true
        },
        "stub_word_count": {
          "oneOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ]
        },
        "csr_esg_pages": {
          "type": "array",
          "items": {"$ref": "#/$defs/page"},
          "uniqueItems": true
        },
        "ambiguity_code": {
          "enum": [
            "NONE",
            "PRESENCE_UNRESOLVABLE",
            "START_UNRESOLVABLE",
            "END_UNRESOLVABLE",
            "SPAN_UNRESOLVABLE",
            "TITLE_CONTEXT_UNRESOLVABLE"
          ]
        },
        "admissible_spans": {
          "type": "array",
          "items": {"$ref": "#/$defs/span"},
          "uniqueItems": true
        },
        "parent_section": {"type": ["string", "null"], "maxLength": 512},
        "annexure_identity": {"type": ["string", "null"], "maxLength": 512},
        "boundary_evidence": {
          "type": "object",
          "required": [
            "heading_start_page",
            "substantive_start_page",
            "last_content_page",
            "next_section_heading_page",
            "mixed_end_page",
            "start_page_shared",
            "end_page_shared",
            "start_anchor_text",
            "end_anchor_text"
          ],
          "properties": {
            "heading_start_page": {
              "oneOf": [{"$ref": "#/$defs/page"}, {"type": "null"}]
            },
            "substantive_start_page": {
              "oneOf": [{"$ref": "#/$defs/page"}, {"type": "null"}]
            },
            "last_content_page": {
              "oneOf": [{"$ref": "#/$defs/page"}, {"type": "null"}]
            },
            "next_section_heading_page": {
              "oneOf": [{"$ref": "#/$defs/page"}, {"type": "null"}]
            },
            "mixed_end_page": {
              "oneOf": [{"$ref": "#/$defs/page"}, {"type": "null"}]
            },
            "start_page_shared": {"type": ["boolean", "null"]},
            "end_page_shared": {"type": ["boolean", "null"]},
            "start_anchor_text": {"type": ["string", "null"]},
            "end_anchor_text": {"type": ["string", "null"]},
            "viewer_start_page_1based": {
              "oneOf": [{"$ref": "#/$defs/viewerPage"}, {"type": "null"}]
            },
            "viewer_end_page_1based": {
              "oneOf": [{"$ref": "#/$defs/viewerPage"}, {"type": "null"}]
            }
          },
          "additionalProperties": false
        },
        "timestamps": {
          "type": "object",
          "required": ["started_at", "completed_at"],
          "properties": {
            "started_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
            },
            "completed_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
            }
          },
          "additionalProperties": false
        },
        "aids_used": {
          "type": "array",
          "items": {
            "enum": [
              "PDF_VIEWER",
              "THUMBNAILS",
              "IN_PDF_SEARCH",
              "BOOKMARKS",
              "ZOOM_ROTATE",
              "PAGE_COUNT_DISPLAY"
            ]
          },
          "uniqueItems": true
        },
        "structured_provenance": {
          "type": "object",
          "required": [
            "annotation_workspace_id",
            "viewer_name",
            "viewer_version",
            "viewer_page_convention",
            "physical_page_count",
            "search_queries",
            "search_usable",
            "bookmark_pages",
            "flag_pages",
            "source_pdf_hash_verified",
            "no_repository_access_attested",
            "no_system_output_access_attested"
          ],
          "properties": {
            "annotation_workspace_id": {"type": "string", "minLength": 1},
            "viewer_name": {"type": "string", "minLength": 1},
            "viewer_version": {"type": "string", "minLength": 1},
            "viewer_page_convention": {
              "const": "VIEWER_PHYSICAL_1_BASED_STORED_ZERO_BASED"
            },
            "physical_page_count": {"type": "integer", "minimum": 1},
            "search_queries": {"type": "array", "items": {"type": "string"}},
            "search_usable": {"type": "boolean"},
            "bookmark_pages": {
              "type": "array",
              "items": {"$ref": "#/$defs/page"},
              "uniqueItems": true
            },
            "flag_pages": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {"$ref": "#/$defs/page"},
                "uniqueItems": true
              }
            },
            "visible_parent_heading": {"type": ["string", "null"]},
            "conditional_title_context": {"type": ["string", "null"]},
            "source_pdf_hash_verified": {"const": true},
            "no_repository_access_attested": {"const": true},
            "no_system_output_access_attested": {"const": true},
            "raw_record_sha256_refs": {
              "type": "array",
              "items": {"$ref": "#/$defs/sha256"},
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "protocol_version_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "presenceRules": {
      "allOf": [
        {
          "if": {"properties": {"presence_state": {"const": "PRESENT"}}},
          "then": {
            "properties": {
              "presence_reason_code": {
                "enum": ["BODY_QUALIFYING_TITLE", "CONDITIONAL_TITLE_CONTEXT_MET"]
              },
              "primary_span": {"$ref": "#/$defs/span"},
              "ambiguity_code": {"const": "NONE"},
              "admissible_spans": {"maxItems": 0},
              "boundary_evidence": {
                "properties": {
                  "start_page_shared": {"type": "boolean"},
                  "end_page_shared": {"type": "boolean"}
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"presence_state": {"const": "ABSENT"}}},
          "then": {
            "properties": {
              "presence_reason_code": {
                "enum": [
                  "NO_QUALIFYING_BODY_SECTION",
                  "TOC_ONLY",
                  "POINTER_ONLY",
                  "CONFUSABLE_SECTION_ONLY",
                  "NOT_AN_ANNUAL_REPORT",
                  "NO_ENGLISH_MDA",
                  "EXTERNAL_REFERENCE_ONLY"
                ]
              },
              "primary_span": {"type": "null"},
              "gap_pages": {"maxItems": 0},
              "ambiguity_code": {"const": "NONE"},
              "admissible_spans": {"maxItems": 0},
              "boundary_evidence": {
                "properties": {
                  "start_page_shared": {"type": "null"},
                  "end_page_shared": {"type": "null"}
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "presence_reason_code": {"const": "NO_ENGLISH_MDA"}
                  },
                  "required": ["presence_reason_code"]
                },
                "then": {
                  "properties": {
                    "alternative_spans": {
                      "items": {
                        "properties": {"type": {"const": "HINDI_COPY"}}
                      }
                    }
                  }
                },
                "else": {"properties": {"alternative_spans": {"maxItems": 0}}}
              }
            ]
          }
        },
        {
          "if": {"properties": {"presence_state": {"const": "AMBIGUOUS"}}},
          "then": {
            "properties": {
              "presence_reason_code": {
                "enum": [
                  "PRESENCE_UNRESOLVABLE",
                  "START_UNRESOLVABLE",
                  "END_UNRESOLVABLE",
                  "SPAN_UNRESOLVABLE",
                  "TITLE_CONTEXT_UNRESOLVABLE"
                ]
              },
              "primary_span": {"type": "null"},
              "ambiguity_code": {"not": {"const": "NONE"}},
              "admissible_spans": {"minItems": 1},
              "boundary_evidence": {
                "properties": {
                  "start_page_shared": {"type": "null"},
                  "end_page_shared": {"type": "null"}
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {"flags": {"contains": {"const": "noncontiguous_hull"}}}
          },
          "then": {"properties": {"gap_pages": {"minItems": 1}}},
          "else": {"properties": {"gap_pages": {"maxItems": 0}}}
        },
        {
          "if": {"properties": {"flags": {"contains": {"const": "annexure"}}}},
          "then": {
            "properties": {"annexure_identity": {"type": "string", "minLength": 1}}
          },
          "else": {"properties": {"annexure_identity": {"type": "null"}}}
        },
        {
          "if": {
            "properties": {
              "flags": {"contains": {"const": "embedded_in_directors_report"}}
            }
          },
          "then": {
            "properties": {"parent_section": {"type": "string", "minLength": 1}}
          },
          "else": {"properties": {"parent_section": {"type": "null"}}}
        },
        {
          "if": {"properties": {"flags": {"contains": {"const": "stub"}}}},
          "then": {"properties": {"presence_state": {"const": "PRESENT"}}}
        },
        {
          "if": {
            "required": ["stub_word_count"],
            "properties": {"stub_word_count": {"type": "integer"}}
          },
          "then": {
            "properties": {"flags": {"contains": {"const": "stub"}}}
          }
        },
        {
          "if": {
            "properties": {"flags": {"contains": {"const": "contains_csr_esg"}}}
          },
          "then": {
            "required": ["csr_esg_pages"],
            "properties": {
              "presence_state": {"const": "PRESENT"},
              "csr_esg_pages": {"minItems": 1}
            }
          },
          "else": {"properties": {"csr_esg_pages": {"maxItems": 0}}}
        },
        {
          "if": {
            "properties": {"flags": {"contains": {"const": "mixed_start_page"}}}
          },
          "then": {
            "properties": {
              "boundary_evidence": {
                "properties": {"start_page_shared": {"const": true}}
              }
            }
          },
          "else": {
            "properties": {
              "boundary_evidence": {
                "properties": {"start_page_shared": {"not": {"const": true}}}
              }
            }
          }
        },
        {
          "if": {
            "properties": {"flags": {"contains": {"const": "mixed_end_page"}}}
          },
          "then": {
            "properties": {
              "boundary_evidence": {
                "properties": {"end_page_shared": {"const": true}}
              }
            }
          },
          "else": {
            "properties": {
              "boundary_evidence": {
                "properties": {"end_page_shared": {"not": {"const": true}}}
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "boundary_evidence": {
                "properties": {"start_page_shared": {"const": true}}
              }
            }
          },
          "then": {
            "properties": {
              "boundary_evidence": {
                "properties": {"start_anchor_text": {"type": "string", "pattern": "\\S"}}
              }
            }
          },
          "else": {
            "properties": {
              "boundary_evidence": {
                "properties": {"start_anchor_text": {"type": "null"}}
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "boundary_evidence": {
                "properties": {"end_page_shared": {"const": true}}
              }
            }
          },
          "then": {
            "properties": {
              "boundary_evidence": {
                "properties": {"end_anchor_text": {"type": "string", "pattern": "\\S"}}
              }
            }
          },
          "else": {
            "properties": {
              "boundary_evidence": {
                "properties": {"end_anchor_text": {"type": "null"}}
              }
            }
          }
        }
      ]
    },
    "rawRecord": {
      "title": "Immutable raw Annotator A or B record",
      "allOf": [
        {"$ref": "#/$defs/commonRecord"},
        {"$ref": "#/$defs/presenceRules"},
        {
          "properties": {
            "record_type": {"const": "RAW"},
            "annotator_role": {"enum": ["ANNOTATOR_A", "ANNOTATOR_B"]},
            "structured_provenance": {
              "not": {"required": ["raw_record_sha256_refs"]}
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "adjudicatedRecord": {
      "title": "Adjudicated record created after independent A/B records",
      "allOf": [
        {"$ref": "#/$defs/commonRecord"},
        {"$ref": "#/$defs/presenceRules"},
        {
          "required": [
            "adjudication_status",
            "adjudication_reason",
            "adjudicator_role"
          ],
          "properties": {
            "record_type": {"const": "ADJUDICATED"},
            "annotator_role": {"const": "ADJUDICATED_RECORD"},
            "structured_provenance": {
              "required": ["raw_record_sha256_refs"]
            },
            "adjudication_status": {
              "enum": [
                "AGREEMENT_CONFIRMED",
                "DISAGREEMENT_RESOLVED",
                "AMBIGUITY_PRESERVED"
              ]
            },
            "adjudication_reason": {"type": "string", "minLength": 1},
            "adjudicator_role": {"const": "SEPARATE_ADJUDICATOR"}
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
